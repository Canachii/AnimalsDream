        <ui:VisualElement name="RoomCodeContainer" style="position: absolute; flex-grow: 1; bottom: 55px; left: 30px; display: none;">
            <ui:Label text="초대 코드: AC18E4" name="RoomCodeText" style="font-size: 32px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/NANUMGOTHICBOLD.TTF?fileID=12800000&amp;guid=11c7692c5defc9e4daff7ddbbc7c3fb5&amp;type=3#NANUMGOTHICBOLD&quot;);" />
